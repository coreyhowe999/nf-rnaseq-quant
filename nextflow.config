// nf-rnaseq-quant — top-level config
// Loaded automatically by Nextflow. Profiles are composed: -profile test,docker

manifest {
    name            = 'coreyhowe999/nf-rnaseq-quant'
    description     = 'Bulk RNA-seq quantification with Salmon (Nextflow DSL2)'
    author          = 'Corey Howe'
    version         = '0.1.0'
    nextflowVersion = '>=23.10.0'
    mainScript      = 'main.nf'
}

// ---- Default params --------------------------------------------------------
params {
    samplesheet     = null
    transcriptome   = null
    outdir          = './results'

    salmon_libtype  = 'A'
    skip_trim       = false
    skip_multiqc    = false

    // Resource caps (per-process labels in conf/base.config respect these)
    max_cpus        = 8
    max_memory      = '16.GB'
    max_time        = '12.h'

    publish_dir_mode = 'copy'
}

// ---- Base process resources -----------------------------------------------
includeConfig 'conf/base.config'

// ---- Reports ---------------------------------------------------------------
def trace_time = new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm-ss').format(new Date())
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_time}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${trace_time}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_time}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${trace_time}.html" }

// ---- Profiles --------------------------------------------------------------
profiles {

    standard {
        process.executor = 'local'
    }

    test {
        includeConfig 'conf/test.config'
    }

    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        singularity.enabled    = false
        conda.enabled          = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }

    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'compute'
    }
}
