// Per-process resource defaults. Use labels in module process declarations
// (e.g. `label 'process_high'`) to opt into a tier.
//
// All requests are capped against params.max_cpus/max_memory/max_time so the
// same pipeline scales sanely from laptops to HPC without per-site rewrites.

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            def cap = params.max_memory as nextflow.util.MemoryUnit
            return obj.compareTo(cap) == 1 ? cap : obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            def cap = params.max_time as nextflow.util.Duration
            return obj.compareTo(cap) == 1 ? cap : obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj as int, params.max_cpus as int)
        } catch (all) { return obj }
    }
}

process {
    cpus   = { check_max( 1,        'cpus'   ) }
    memory = { check_max( 2.GB,     'memory' ) }
    time   = { check_max( 2.h,      'time'   ) }

    errorStrategy = { task.exitStatus in [137, 139, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel:process_low {
        cpus   = { check_max( 2,        'cpus'   ) }
        memory = { check_max( 4.GB,     'memory' ) }
        time   = { check_max( 2.h,      'time'   ) }
    }
    withLabel:process_medium {
        cpus   = { check_max( 4,        'cpus'   ) }
        memory = { check_max( 8.GB,     'memory' ) }
        time   = { check_max( 6.h,      'time'   ) }
    }
    withLabel:process_high {
        cpus   = { check_max( 8,        'cpus'   ) }
        memory = { check_max( 16.GB,    'memory' ) }
        time   = { check_max( 12.h,     'time'   ) }
    }
}
