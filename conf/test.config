// Test profile — small public data, runs end-to-end in ~2 min on a laptop.
//
// Sources:
//   * Reads: nf-core test data (sample subsets from a yeast RNA-seq experiment)
//   * Transcriptome: yeast (S. cerevisiae) cDNA, Ensembl R64-1-1

params {
    // Bundled samplesheet pointing at remote tiny test FASTQs
    samplesheet   = "${projectDir}/assets/samplesheet_test.csv"

    // Yeast transcriptome from Ensembl (~3.4 MB gzipped)
    transcriptome = 'https://ftp.ensembl.org/pub/release-110/fasta/saccharomyces_cerevisiae/cdna/Saccharomyces_cerevisiae.R64-1-1.cdna.all.fa.gz'

    outdir        = './results-test'

    // Tight resource caps for CI / laptop runs
    max_cpus      = 2
    max_memory    = '6.GB'
    max_time      = '1.h'
}
